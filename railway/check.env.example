# Railway — маршрут и пассажиры
# cp check.env.example check.env
# Список ID станций: ./run.sh --stations

# Станции (ID из GET /v2/stations):
# Ашхабад (Ashgabat) = 17
# Туркменабад (Turkmenabat) = 49

SOURCE_STATION_ID=17
DESTINATION_STATION_ID=49

DATE=10.08.2026

# Тип вагона (ID из wagon_types в GET /v2/trips):
# Kupe = 2
# Plaskart = 3
# VIP Kupe = 5
# Один тип: WAGON_TYPE_ID=3
# Fallback (сначала plaskart, потом kupe): WAGON_TYPE_ID=3,2
WAGON_TYPE_ID=3,2

# Рейс — TRAIN_INDEX или TRAIN_TIME (список: ./run.sh --trips):
# TRAIN_INDEX: 1 = [1], 2 = [2] (нумерация с 1, не с 0)
# [1] 13:50 №95 Aşgabat→Türkmenabat
# [2] 19:50 №03 Aşgabat→Türkmenabat
TRAIN_INDEX=1
# TRAIN_TIME=13:50

# RAILWAY_STRICT=1 — только выбранный рейс (TRAIN_INDEX / TRAIN_TIME), без запасных
# RAILWAY_STRICT=0 — если на выбранном нет мест, бронировать другой доступный
RAILWAY_STRICT=0

# Мультимедиа / Wi‑Fi в брони (has_media_wifi): 1 — да, 0 — нет
RAILWAY_MULTIMEDIA=0

# Главный пассажир из passengers.json (adult/child считаются автоматически)
PASSENGER_IDS=1

NOTIFY_EMAIL=you@gmail.com
