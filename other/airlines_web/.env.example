# Маршрут, бронь и аккаунт — cp .env.example .env
# Капча, браузер, окна — cp .env.local.example .env.local

DEPART_PORT_CODE=ASB
ARRIVAL_PORT_CODE=CRZ

DATES=17.07.2026,18.07.2026
PASSENGER_IDS=1

# FLIGHT_INDEX: 1 = [1], 4,3 = сначала [4], затем [3] (нумерация с 1, как TRAIN_INDEX в railway)
FLIGHT_INDEX=1
FLIGHT_STRICT=0
# FLIGHT_TIME=06:30

NOTIFY_EMAIL=

# Один аккаунт T5 для acc1+acc2 (два браузера — run_dual / --account)
T5_PHONE=
T5_PASSWORD=
