# Настройки и ключи — не коммитить.
# cp .env.local.example .env.local

INTERVAL_SEC=60

GMAIL_USER=
GMAIL_APP_PASSWORD=
PASSENGERS_FILE=passengers.json

# === Капча (локальная CNN, браузер) ===
CAPTCHA_IMG_TIMEOUT_WAIT_SEC=30
SAVE_BANDWIDTH=1
TICKETS_WAIT_SEC=16
TICKETS_STALE_SEC=6
# reload /flights/search сбрасывает сессию → редирект на главную; держите 0
TICKETS_RELOAD_ON_STUCK=0
CAPTCHA_COLLECT=1
CAPTCHA_COLLECT_REJECTED=1
CAPTCHA_AUTO_TRAIN=0
CAPTCHA_AUTO_TRAIN_MIN=50

# Браузер (общее для всех аккаунтов)
# HEADLESS=1 — без окна Chrome (VPS/фон; ручная капча недоступна)
HEADLESS=0
CLEAR_BROWSER_EVERY_MIN=30
CLEAR_BROWSER_PHASE_MIN=4
BROWSER_CHANNEL=chrome
USE_PERSISTENT_PROFILE=1
BROWSER_WINDOW_SIZE=1200,900

# Защита от блокировок аккаунта
BOOK_RETRY_DELAY_SEC=3
CAPTCHA_MAX_ATTEMPTS=5
BOOK_SEARCH_MAX_ROUNDS=3
BOOK_SEARCH_MAX_PER_HOUR=40
LOGIN_FAIL_COOLDOWN_SEC=600
LOGIN_FAIL_STREAK_LIMIT=3

DUAL_STOP_ON_BANK=1
BOOK_QUICK_RETRY=0
BOOK_QUICK_RETRY_IF_LEFT_SEC=30
BOOK_QUICK_RETRY_WAIT_SEC=5

# Слот поиска и позиция окна — своё для каждого аккаунта
ACC1_BOOK_SEARCH_AT_SEC=0
ACC1_BROWSER_WINDOW_POS=0,0
ACC2_BOOK_SEARCH_AT_SEC=30
ACC2_BROWSER_WINDOW_POS=700,0
