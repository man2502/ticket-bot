# Клон .env для другого пассажира / аккаунта (полный файл):
#   cp .env profiles/pax2.env
#   # поменяй T5_*, PASSENGER_IDS, DATES, маршрут…
#   .venv/bin/python run_dual.py --env profiles/pax2.env
#
# Или только маршрут/пассажир поверх .env (аккаунт из .env):
#   .venv/bin/python run_dual.py --profile pax2

DEPART_PORT_CODE=ASB
ARRIVAL_PORT_CODE=CRZ

DATES=28.07.2026
PASSENGER_IDS=1

FLIGHT_INDEX=1
FLIGHT_STRICT=0

NOTIFY_EMAIL=

# Свой аккаунт T5 для этого профиля (перекрывает .env)
T5_PHONE=
T5_PASSWORD=
