# Настройки API-монитора — не коммитить.
# cp .env.local.example .env.local

# User-Agent iOS генерируется при старте и каждые 45–55 мин (API_USER_AGENT не нужен)
API_BUILD_VERSION=79

# Bearer-токены: login не на каждый старт, кроме смены логина/пароля.
# Каждый цикл — GET customers/info; 401 token_type=client|customer
# обновляет только этот токен.
API_SAVE_TOKENS=0

# Авто-логин ios → Bearer (API_AUTO_REFRESH_TOKENS=1)
API_AUTO_REFRESH_TOKENS=1
API_IOS_LOGIN=ios
API_IOS_PASSWORD=your_ios_api_password

INTERVAL_SEC=60

GMAIL_USER=
GMAIL_APP_PASSWORD=
# recipients можно и здесь (иначе из check.env NOTIFY_EMAIL)
# NOTIFY_EMAIL=you@gmail.com
# passengers.json в корне репозитория
PASSENGERS_FILE=passengers.json

# Как часто проверять: 10 / 30 / 60 / 120 секунд.
# Отсчёт от API_CHECK_AT_SEC, окно шириной в секунду, выстрел в случайную
# десятую долю внутри него. 10 секунд — шесть заходов в минуту, заметно
# повышает риск 429; держать сутками не стоит.
API_CHECK_PERIOD_SEC=30
API_CHECK_AT_SEC=0
# Старые флаги ниже ещё работают, если период не задан: обе единицы = 30 секунд.
# API_CHECK_EVERY_00=1
# API_CHECK_EVERY_30=1
# API_DELAY=1 — jitter и паузы капчи; API_DELAY=0 — сразу в слот без пауз
API_DELAY=0

# API-капча (5 цифр)
CAPTCHA_API_MANUAL=1
CAPTCHA_API_MAX_ATTEMPTS=5
CAPTCHA_API_COLLECT=1
CAPTCHA_API_COLLECT_REJECTED=1
CAPTCHA_API_COMPARE=1
CAPTCHA_API_USE_CNN=1

# Авто-бронь при появлении мест (CreateBooking + email с checkoutUrl и PNR)
API_AUTO_BOOK=0
# API_PAYMENT_TYPE=halkbank
# API_SEARCH_ERROR_MAX_RETRIES=3
# API_REPEATED_ERROR_PAUSE_AFTER=3
# API_REPEATED_ERROR_PAUSE_MIN=60
# API_REPEATED_ERROR_PAUSE_MAX=90
# HTTP 429: пауза 150с, повтор в течение 10 мин → 300, 600, …
# API_RATE_LIMIT_PAUSE_SEC=150
# API_RATE_LIMIT_WINDOW_SEC=600
# Профилактика на сервере — пауза 2–4 мин (секунды)
# API_MAINTENANCE_PAUSE_MIN=120
# API_MAINTENANCE_PAUSE_MAX=240
# API_DEBUG_AUTH=1
# Контактное лицо брони. Если не задать, берётся первый взрослый пассажир.
# API_CONTACT_EMAIL обязателен: на него сервер T5 шлёт подтверждение и ссылку
# на оплату, а без него отвечает `Error Create (HTTP 404)` — то есть отвергает
# бронь на валидации. Бот такой запрос теперь не отправляет вовсе.
# API_CONTACT_NAME=
# API_CONTACT_SURNAME=
# API_CONTACT_EMAIL=
# API_CONTACT_PHONE=
