# Проверка рейсов через API (python api_check.py)
# cp check.env.example check.env
# Секреты (ios password, Gmail) — в airlines_api/.env.local

# --- Авто-логин customer ---
API_CUSTOMER_PHONE=+99363047340
API_CUSTOMER_PASSWORD=your_account_password

# Маршрут
DEPART_PORT_CODE=ASB
ARRIVAL_PORT_CODE=MYP

# Дата рейса (DD.MM.YYYY или MM/DD/YYYY)
DATE=31.07.2026

# id пассажиров из passengers.json → adult/child/infant для API
PASSENGER_IDS=1

# Какой рейс выбирать (как в book.py / steps.py)
# FLIGHT_INDEX: 1 = [1], 4,3 = сначала [4], затем [3] (нумерация с 1).
# Пусто или строки нет вовсе — рейс не выбран: бот проверит все прямые
# рейсы с местами по порядку вылета, как railway с пустым TRAIN_INDEX.
FLIGHT_INDEX=1
FLIGHT_STRICT=0
# FLIGHT_TIME=06:30

# Уведомления (GMAIL_USER + GMAIL_APP_PASSWORD — в airlines_api/.env.local)
NOTIFY_EMAIL=you@gmail.com
# NOTIFY_EMAIL=a@gmail.com, b@gmail.com

# Gmail, PASSENGERS_FILE, INTERVAL_SEC, CAPTCHA_API_*, API_AUTO_BOOK — в airlines_api/.env.local
