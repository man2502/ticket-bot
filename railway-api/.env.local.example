# Railway секреты — не коммитить.
# cp .env.local.example .env.local

RAILWAY_BASE_URL=https://api.railway.gov.tm
RAILWAY_USER_AGENT=Railway/1 CFNetwork/3860.600.12 Darwin/25.5.0
RAILWAY_LANGUAGE=ru

GMAIL_USER=
GMAIL_APP_PASSWORD=
PASSENGERS_FILE=passengers.json
# Как часто проверять: 10 / 30 / 60 / 120 секунд. Отсчёт от CHECK_AT_SEC.
RAILWAY_CHECK_PERIOD_SEC=30
RAILWAY_CHECK_AT_SEC=0
# 1-я отметка круга: точно в срок + случайно 0 / 0.1 / 0.2 сек
# остальные: ±2 сек вокруг отметки (при периоде 30 с это прежние :28–:32)

# 1 — при появлении мест: выбрать место + POST /v2/bookings + email с formUrl
RAILWAY_AUTO_BOOK=0

# Мультимедиа / Wi‑Fi в брони (has_media_wifi). По умолчанию 0
RAILWAY_MULTIMEDIA=0

# --- HTTP ---
# Раздельные таймауты вместо одного timeout=60: залипший коннект больше
# не съедает три слота подряд.
RAILWAY_CONNECT_TIMEOUT=2.5
RAILWAY_READ_TIMEOUT=6
# POST /v2/bookings — ждём ответ дольше, но НЕ повторяем его.
RAILWAY_WRITE_TIMEOUT=12
# Ретраи только для GET (идемпотентные запросы).
RAILWAY_HTTP_RETRIES=2
# 1 — печатать статус и латентность каждого запроса
RAILWAY_HTTP_DEBUG=0
